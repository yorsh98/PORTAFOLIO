---
import '../styles/global.css';
import { site } from '../data/site';

interface Props { title?: string; description?: string; home?: boolean }
const { title = 'Jorge Troncoso | Desarrollo web e IA local y en la nube', description = 'Portafolio profesional de Jorge Troncoso: desarrollo web, infraestructura de IA local y en la nube, RAG y procesamiento documental.', home = false } = Astro.props;
const href = (id: string) => (home ? `#${id}` : `/#${id}`);

/* Iconos (feather, MIT) */
const ICON: Record<string, string> = {
  github: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
  whatsapp: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>'
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06070c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Jorge Troncoso" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'is-loading': home }} data-page={home ? 'home' : 'page'}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="nav" id="nav" data-theme="light">
      <a class="logo" href={href('home')} data-go={home ? 'home' : undefined} aria-label="Inicio"><b>{site.brand.logo}</b><i></i></a>
      <nav class="pill links" aria-label="Principal">
        {site.nav.map(([id, label]) => <a href={href(id)} data-go={home ? id : undefined} data-nav-link>{label}</a>)}
      </nav>
      <div class="nav-right">
        <div class="pill socials">
          {site.social.map((s) => <a href={s.href} aria-label={s.label} target={s.id === 'mail' ? undefined : '_blank'} rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON[s.id]} /></a>)}
        </div>
        <button class="pill menu-btn" type="button" aria-expanded="false" aria-controls="mnav">Menú</button>
      </div>
      <nav class="mnav" id="mnav" aria-label="Principal (móvil)" hidden>
        {site.nav.map(([id, label]) => <a href={href(id)} data-go={home ? id : undefined} data-nav-link>{label}</a>)}
        <a href={href('contact')} data-go={home ? 'contact' : undefined}>Contacto</a>
      </nav>
    </header>
    <slot />
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!, menu = document.querySelector<HTMLElement>('#mnav')!;
      const setMenu = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); menu.hidden = !open; };
      btn.addEventListener('click', () => setMenu(btn.getAttribute("aria-expanded") !== "true"));
      menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setMenu(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
      document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.nav')) setMenu(false); });

      // En páginas internas el tema de la barra sigue a la sección bajo ella (en la portada lo maneja echo.ts).
      if (document.body.dataset.page !== 'home') {
        const nav = document.querySelector<HTMLElement>('#nav')!, themed = [...document.querySelectorAll<HTMLElement>('[data-nav-theme]')];
        const update = () => {
          const s = themed.find((el) => { const r = el.getBoundingClientRect(); return r.top <= 40 && r.bottom > 40; });
          nav.dataset.theme = s?.dataset.navTheme ?? 'light';
        };
        addEventListener('scroll', update, { passive: true }); update();
        document.body.classList.add('ready');
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .15 });
        document.querySelectorAll('[data-reveal], .case-body').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
