---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
---
<BaseLayout title="Proyectos | Jorge Troncoso" description="Casos de desarrollo web, RAG y fine-tuning de modelos de inteligencia artificial.">
  <main id="contenido" class="container-shell py-28">
    <a href="/" class="text-sm text-cyan-300">← Volver al inicio</a>
    <p class="eyebrow mt-12">Casos de trabajo</p><h1 class="section-title">Proyectos seleccionados</h1><p class="section-copy">Aplicaciones web, procesamiento documental y trabajo aplicado con modelos de inteligencia artificial.</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {projects.map((project) => <article class="glass rounded-3xl p-6"><p class="text-xs font-bold uppercase tracking-widest text-cyan-300">{project.category}</p><h2 class="mt-4 text-2xl font-black">{project.title}</h2><p class="mt-3 text-sm leading-6 text-slate-300">{project.description}</p><div class="mt-5 flex flex-wrap gap-2">{project.technologies.slice(0, 7).map((tech) => <span class="tag">{tech}</span>)}</div><a href={`/proyectos/${project.slug}`} class="mt-6 inline-flex font-bold">Ver caso de estudio <span class="ml-2" aria-hidden="true">→</span></a></article>)}
    </div>
  </main>
</BaseLayout>
