---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<BaseLayout title={`${project.title} | Jorge Troncoso`} description={project.description}>
  <main id="contenido" class="container-shell py-28">
    <a href="/proyectos" class="text-sm text-cyan-300">← Volver a proyectos</a>
    <section class="mt-12 grid gap-8 lg:grid-cols-[1.15fr_.85fr]">
      <div><p class="eyebrow">{project.category}</p><h1 class="section-title">{project.title}</h1><p class="section-copy text-lg">{project.description}</p></div>
      <aside class="glass rounded-3xl p-6"><p class="text-sm font-bold text-slate-200">Tecnologías principales</p><div class="mt-4 flex flex-wrap gap-2">{project.technologies.map((tech) => <span class="tag">{tech}</span>)}</div></aside>
    </section>
    <section class="mt-14 grid gap-5 md:grid-cols-2">
      <article class="glass rounded-3xl p-6"><h2 class="text-xl font-black">Objetivo</h2><p class="mt-3 leading-7 text-slate-300">{project.objective}</p></article>
      <article class="glass rounded-3xl p-6"><h2 class="text-xl font-black">Solución</h2><p class="mt-3 leading-7 text-slate-300">{project.solution}</p></article>
      <article class="glass rounded-3xl p-6"><h2 class="text-xl font-black">Arquitectura</h2><p class="mt-3 leading-7 text-slate-300">{project.architecture}</p></article>
      <article class="glass rounded-3xl p-6"><h2 class="text-xl font-black">Publicación</h2><p class="mt-3 leading-7 text-slate-300">{project.publicationNote}</p></article>
    </section>
  </main>
</BaseLayout>
