---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const gallery = (project.gallery ?? []).map((g, i) => typeof g === 'string' ? { src: g, caption: `Captura ${i + 1} de ${project.title}` } : g);
const index = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(index + 1) % projects.length];
const blocks = [
  ['Objetivo', project.objective], ['Solución', project.solution],
  ['Arquitectura', project.architecture], ['Infraestructura', project.infrastructure]
] as const;
---
<BaseLayout title={`${project.title} | Jorge Troncoso`} description={project.description}>
  <main id="contenido" class="case">
    <section class="case-hero" data-nav-theme="light">
      <a class="case-back mono" href="/#projects">← Volver a proyectos</a>
      <p class="case-cat mono">{String(index + 1).padStart(2, '0')} · {project.category}</p>
      <h1 class="case-title">{project.title}</h1>
      <p class="case-lead">{project.description}</p>
      <ul class="case-tags">{project.technologies.map((t) => <li>{t}</li>)}</ul>
      {project.image && (
        <figure class="case-shot">
          <button type="button" data-shot={project.image.src} data-alt={project.image.alt} aria-label={`Ampliar imagen de ${project.title}`}>
            <img src={project.image.src} alt={project.image.alt} width="1600" height="900" decoding="async" />
          </button>
        </figure>
      )}
    </section>

    <section class="case-body" data-nav-theme="dark">
      <div class="sec-line"></div>
      <div class="case-grid">
        {blocks.map(([k, v], i) => (
          <article data-reveal style={`--delay:${(i % 2) * 90}ms`}>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <h2>{k}</h2>
            <p>{v}</p>
          </article>
        ))}
        <article class="case-note" data-reveal>
          <span class="mono">05</span>
          <h2>Alcance de publicación</h2>
          <p>{project.publicationNote}</p>
        </article>
      </div>

      {gallery.length > 0 && (
        <div class="case-gallery">
          <p class="eyebrow-s mono" data-reveal>INTERFAZ DEL SISTEMA</p>
          <h2 class="big-title" data-reveal>GALERÍA</h2>
          <ul>
            {gallery.map(({ src, caption }, i) => (
              <li data-reveal style={`--delay:${(i % 3) * 70}ms`}>
                <button type="button" data-shot={src} data-alt={caption} aria-label={`Ampliar: ${caption}`}>
                  <img src={src} alt={caption} width="1200" height="675" loading="lazy" decoding="async" />
                </button>
                <p class="case-caption">{caption}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

      <a class="case-next" href={`/proyectos/${next.slug}`} data-reveal>
        <small class="mono">SIGUIENTE PROYECTO</small>
        <span>{next.title} ↗</span>
      </a>
    </section>

    <dialog class="lightbox" id="shotDialog" aria-label="Vista ampliada de captura">
      <button type="button" class="lb-close" data-close>Cerrar</button>
      <figure><img src="" alt="" /><figcaption class="mono"></figcaption></figure>
      <div class="lb-nav"><button type="button" data-step="-1">← Anterior</button><button type="button" data-step="1">Siguiente →</button></div>
    </dialog>
  </main>

  <script>
    const dlg = document.querySelector<HTMLDialogElement>('#shotDialog')!;
    const img = dlg.querySelector('img')!, cap = dlg.querySelector('figcaption')!;
    const shots = [...document.querySelectorAll<HTMLButtonElement>('[data-shot]')];
    let cur = 0, opener: HTMLElement | null = null, touchX: number | null = null;
    const show = (i: number) => {
      cur = (i + shots.length) % shots.length;
      img.src = shots[cur].dataset.shot!; img.alt = shots[cur].dataset.alt!;
      cap.textContent = `${shots[cur].dataset.alt} · ${cur + 1} / ${shots.length}`;
      if (!dlg.open) dlg.showModal();
    };
    shots.forEach((b, i) => b.addEventListener('click', () => { opener = b; show(i); }));
    dlg.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t === dlg || t.closest('[data-close]')) dlg.close();
      const s = t.closest<HTMLElement>('[data-step]'); if (s) show(cur + Number(s.dataset.step));
    });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(cur + 1); if (e.key === 'ArrowLeft') show(cur - 1); });
    img.addEventListener('touchstart', (e) => { touchX = e.touches[0]?.clientX ?? null; }, { passive: true });
    img.addEventListener('touchend', (e) => {
      const x = e.changedTouches[0]?.clientX; if (touchX === null || x === undefined) return;
      const dx = x - touchX; touchX = null; if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1));
    }, { passive: true });
    dlg.addEventListener('close', () => { opener?.focus(); opener = null; });
  </script>
</BaseLayout>
