---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { technologies, categoryLabels } from '../data/technologies';
import iconSet from '@iconify-json/simple-icons/icons.json';

const technologyCustomIcons: Record<string, string> = {
  cuda: '<rect x="4" y="4" width="16" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 9h8v6H8zM2 8h2m16 0h2M2 12h2m16 0h2M2 16h2m16 0h2M8 2v2m4-2v2m4-2v2M8 20v2m4-2v2m4-2v2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>'
};
const selectedTech = technologies.map((tech) => ({ ...tech, iconBody: technologyCustomIcons[tech.slug] ?? iconSet.icons[tech.slug as keyof typeof iconSet.icons]?.body }));
const featuredStack = [['Laravel + React/Vue', 'laravel'], ['FastAPI + Celery + Redis', 'fastapi'], ['Ollama + LangGraph + LLMs', 'ollama'], ['Docker Compose + NVIDIA CUDA', 'docker']].map(([name, slug]) => ({ name, slug, iconBody: iconSet.icons[slug as keyof typeof iconSet.icons]?.body }));
const technologyBySlug = new Map(selectedTech.map((tech) => [tech.slug, tech]));
const technologyMapPositions = [
  ['html5', 13.5, 69],
  ['css3', 22, 64],
  ['javascript', 30.5, 59],
  ['typescript', 29.5, 75],
  ['react', 14.5, 48],
  ['vuedotjs', 20.4, 44],
  ['livewire', 38, 69],
  ['tailwindcss', 20.4, 53.5],
  ['vite', 22, 80],
  ['astro', 8.5, 52],
  ['bootstrap', 14.5, 57],
  ['laravel', 69.8, 19.2],
  ['php', 69.8, 26.2],
  ['fastapi', 80.7, 20.6],
  ['python', 81, 26.9],
  ['ollama', 84.5, 35],
  ['langchain', 75.4, 42.5],
  ['langgraph', 94, 42.5],
  ['huggingface', 75.4, 53.5],
  ['modelcontextprotocol', 93.4, 53.5],
  ['pgvector', 84.2, 59],
  ['postgresql', 42.6, 82.8],
  ['mariadb', 47.8, 85.2],
  ['redis', 53.1, 87.8],
  ['docker', 64, 65],
  ['ubuntu', 61.2, 79.1],
  ['nvidia', 71.8, 72.6],
  ['cuda', 54.3, 72]
] as const;
const technologyMapItems = technologyMapPositions.map(([slug, x, y]) => {
  const technology = technologyBySlug.get(slug);
  return { slug, x, y, name: technology?.name ?? slug, category: technology?.category ?? 'frontend', iconBody: technology?.iconBody };
});
const webProjects = projects.filter((project) => project.kind === 'web');
const modelProject = projects.find((project) => project.kind === 'model');
const profileTechnologies = [
  ['PHP', 'php'], ['Laravel', 'laravel'], ['Python', 'python'], ['HTML5', 'html5'], ['CSS3', 'css3'], ['JavaScript', 'javascript'], ['Ollama', 'ollama'], ['Hugging Face', 'huggingface'], ['ChatGPT / Codex App', 'openai'], ['OpenCode CLI', 'opencode'], ['Antigravity CLI', 'antigravity'], ['MCPs', 'modelcontextprotocol'], ['SKILL.md', 'agentskills'], ['SOLID', 'solid-principles'], ['MVC', 'mvc-pattern'], ['RAG documental', 'rag'], ['PostgreSQL', 'postgresql'], ['MySQL', 'mysql'], ['MariaDB', 'mariadb'], ['SQL', 'sql'], ['Git', 'git'], ['GitHub', 'github'], ['Windows', 'windows'], ['Linux', 'linux'], ['macOS', 'apple'], ['Redes', 'network']
] as const;
const profileCustomIcons: Record<string, string> = {
  antigravity: '<defs><linearGradient id="antigravity-gradient" x1="3" y1="20" x2="21" y2="4" gradientUnits="userSpaceOnUse"><stop stop-color="#4785ff"/><stop offset=".35" stop-color="#54d8e7"/><stop offset=".63" stop-color="#95d83e"/><stop offset=".82" stop-color="#ffd63d"/><stop offset="1" stop-color="#ed5b6d"/></linearGradient></defs><path fill="url(#antigravity-gradient)" d="M2.7 20.5 9.2 5.7a3.06 3.06 0 0 1 5.6 0l6.5 14.8h-4.54L12 9.72 7.24 20.5H2.7Z"/><path fill="#07101f" d="m8.88 20.5 3.12-7.08 3.12 7.08h-2.2L12 17.86l-.8 2.64H8.88Z"/>',
  'solid-principles': '<path fill="none" stroke="currentColor" stroke-width="1.8" d="m12 2.7 7.55 4.35v8.9L12 20.3l-7.55-4.35v-8.9L12 2.7Z"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M8.4 8.2h7.2M8.4 12h7.2M8.4 15.8h4.1" stroke-linecap="round"/>',
  'mvc-pattern': '<rect x="3" y="4" width="6.2" height="5.4" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="14.8" y="4" width="6.2" height="5.4" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/><rect x="8.9" y="14.6" width="6.2" height="5.4" rx="1" fill="none" stroke="currentColor" stroke-width="1.7"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="m9.2 9.2 2.8 5.1m2.8-5.1-2.8 5.1" stroke-linecap="round"/>',
  rag: '<path fill="none" stroke="currentColor" stroke-width="1.8" d="M6 3.5h8.2l3.8 3.8v13.2H6V3.5Z"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M14.2 3.5v3.8H18M9 12h5.7M9 15.5h3.4" stroke-linecap="round"/><circle cx="16.6" cy="17.1" r="2.1" fill="none" stroke="currentColor" stroke-width="1.6"/><path fill="none" stroke="currentColor" stroke-width="1.6" d="m18.2 18.7 2 2" stroke-linecap="round"/>',
  sql: '<ellipse cx="12" cy="5.6" rx="6.8" ry="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M5.2 5.6v6.4c0 1.44 3.05 2.6 6.8 2.6s6.8-1.16 6.8-2.6V5.6m-13.6 6.4v6.4c0 1.44 3.05 2.6 6.8 2.6s6.8-1.16 6.8-2.6V12"/>',
  network: '<circle cx="5" cy="12" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="18.5" cy="5.5" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="18.5" cy="18.5" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="m7.1 10.95 9.25-4.4M7.1 13.05l9.25 4.4" stroke-linecap="round"/>'
};
const selectedProfileTechnologies = profileTechnologies.map(([name, slug]) => ({ name, slug, iconBody: profileCustomIcons[slug] ?? iconSet.icons[slug as keyof typeof iconSet.icons]?.body }));
const credentialFans = [
  {
    title: 'Diplomado y formación INACAP',
    credentials: [
      { title: 'Diplomado Inteligencia Artificial aplicada a negocios', image: '/images/profile/Captura desde 2026-07-28 21-51-24.webp', alt: 'Certificado redactado del Diplomado Inteligencia Artificial aplicada a negocios de INACAP.' },
      { title: 'Fundamentos de Inteligencia Artificial aplicada a negocios', image: '/images/profile/Captura desde 2026-07-28 21-52-26.webp', alt: 'Certificado redactado del curso Fundamentos de Inteligencia Artificial aplicada a negocios.' },
      { title: 'Incorporación de Inteligencia Artificial', image: '/images/profile/Captura desde 2026-07-28 21-52-40.webp', alt: 'Certificado redactado del curso Incorporación de Inteligencia Artificial.' },
      { title: 'Desarrollo y gestión de bases de datos', image: '/images/profile/Captura desde 2026-07-28 21-52-16.webp', alt: 'Certificado redactado del curso Desarrollo y gestión de bases de datos.' }
    ]
  },
  {
    title: 'Especialización complementaria',
    credentials: [
      { title: 'Adopción de Machine Learning para la toma de decisiones', image: '/images/profile/Captura desde 2026-07-28 21-51-47.webp', alt: 'Certificado redactado del curso Adopción de Machine Learning para la toma de decisiones.' },
      { title: 'Curso de Bases y Conceptos de Inteligencia Artificial', image: '/images/profile/Captura desde 2026-07-28 21-50-37.webp', alt: 'Certificado redactado del Curso de Bases y Conceptos de Inteligencia Artificial de Código Facilito.' },
      { title: 'Curso a fondo de GitHub', image: '/images/profile/Captura desde 2026-07-28 21-50-29.webp', alt: 'Certificado redactado del Curso a fondo de GitHub de Código Facilito.' },
      { title: 'Curso de Laravel Profesional', image: '/images/profile/Captura desde 2026-07-28 21-50-47.webp', alt: 'Certificado redactado del Curso de Laravel Profesional de Código Facilito.' }
    ]
  }
] as const;
---
<BaseLayout hideFooter={true} panelNavigation={true}>
  <main id="contenido" class="cube-stage">
    <section id="perfil" data-view="perfil" class="cube-panel" aria-labelledby="perfil-title" aria-hidden="true">
      <div class="cube-panel-content container-shell py-10 sm:py-14">
        <div class="profile-layout">
          <header class="profile-intro">
            <p class="eyebrow">Perfil profesional</p>
            <h1 id="perfil-title" class="section-title" tabindex="-1">Tecnología que resuelve, automatiza y sostiene la operación.</h1>
            <p class="section-copy text-lg">Profesional TI con experiencia desde 2019 en soporte tecnológico, continuidad operativa y desarrollo de soluciones internas para instituciones del Poder Judicial. Combino resolución de incidencias, infraestructura local y desarrollo web para convertir necesidades operativas en herramientas útiles.</p>
            <div class="mt-6 flex flex-wrap gap-2"><span class="tag">Soporte TI</span><span class="tag">Soluciones a medida</span><span class="tag">Automatización</span><span class="tag">Infraestructura local</span></div>
          </header>

          <section class="profile-section" aria-labelledby="capacidades-title">
            <div class="profile-section-heading"><p class="eyebrow">Enfoque de trabajo</p><h2 id="capacidades-title">Del incidente a la solución</h2></div>
            <div class="grid gap-3 md:grid-cols-3">
              <article class="profile-capability"><span class="profile-number">01</span><h3>Continuidad operativa</h3><p>Soporte a usuarios y equipamiento, configuración de puestos, redes, impresoras, audio y salas de audiencias híbridas.</p></article>
              <article class="profile-capability"><span class="profile-number">02</span><h3>Soluciones internas</h3><p>Desarrollo y mantención de sistemas web, automatizaciones y herramientas orientadas a procesos institucionales reales.</p></article>
              <article class="profile-capability"><span class="profile-number">03</span><h3>Entornos técnicos</h3><p>Servidores locales, bases de datos, Linux, redes y herramientas de IA aplicada para apoyar flujos de trabajo.</p></article>
            </div>
          </section>

          <section class="profile-section" aria-labelledby="experiencia-title">
            <div class="profile-section-heading"><p class="eyebrow">Experiencia aplicada</p><h2 id="experiencia-title">Resolver primero. Mejorar después.</h2></div>
            <div class="grid gap-3">
              <article class="profile-experience profile-experience-featured"><div><p class="profile-period">2024 - 2026</p><h3>4to Tribunal de Juicio Oral en lo Penal de Santiago</h3><p class="profile-role">Administrativo tercero Informatico</p></div><div class="profile-experience-details"><p>Impulso mejoras tecnológicas, actualizaciones de flujos de trabajo locales y procedimientos internos, con desarrollos que integran inteligencia artificial local para la gestión documental judicial.</p><ul class="profile-project-list"><li><strong>Plataforma IA Unificada:</strong> ecosistema institucional que centraliza herramientas de IA con portal de usuarios, roles, permisos, auditoría y acceso a módulos; analizador documental; anonimizador de datos personales; transcriptor con seguimiento de tareas; y chatbots respaldados por citas.</li><li><strong>4toTOP:</strong> sistema web para gestión judicial y administrativa, con control de usuarios y permisos, carga y procesamiento de archivos Excel, consulta de correos IMAP, tablas dinámicas y reportes.</li><li><strong>Chatbot UNIJUD:</strong> asistente jurídico conversacional basado en RAG para consultar documentación institucional, recuperar información relevante y generar respuestas con fuentes y citas verificables.</li></ul></div></article>
              <article class="profile-experience"><p class="profile-period">2019 - 2024</p><h3>Soporte tecnologico CAPJ y TOP San bernardo</h3><p class="profile-role">Administrativo Informatico</p><p>Labores administrando equipos, respaldo de audios, redes local, sistemas remotos, salas de audiencia hibridas, sistema de archivos compartidos y atencion de emergencias informaticas, ademas de entregar soporte a distintas competencias jurisdiccionales.</p></article>
            </div>
          </section>

          <section class="profile-section" aria-labelledby="stack-perfil-title">
            <div class="profile-section-heading"><p class="eyebrow">Tecnologías utilizadas</p><h2 id="stack-perfil-title">Una base práctica, de la red al software</h2></div>
            <div class="profile-tech-strip" data-profile-tech-strip tabindex="0" role="region" aria-label="Tecnologías utilizadas. Arrastra o usa las flechas izquierda y derecha para recorrer la lista.">
              {[...selectedProfileTechnologies, ...selectedProfileTechnologies].map((tech, index) => <div class="profile-tech-item" aria-hidden={index >= selectedProfileTechnologies.length ? 'true' : undefined}><div class="profile-tech-icon">{tech.iconBody ? <svg viewBox="0 0 24 24" aria-hidden="true" set:html={tech.iconBody} /> : <span aria-hidden="true">{tech.slug}</span>}</div><span>{tech.name}</span></div>)}
            </div>
          </section>

          <section class="profile-section" aria-labelledby="credenciales-title">
            <div class="profile-section-heading"><p class="eyebrow">Formación continua</p><h2 id="credenciales-title">Credenciales que respaldan el aprendizaje</h2></div>
            <p class="section-copy">Una selección ordenada de formación en inteligencia artificial, datos y desarrollo. Selecciona una credencial para verla en detalle.</p>
            <div class="credential-fans">
              {credentialFans.map((fan) => <section class="credential-fan" data-credential-fan aria-label={fan.title}><h3>{fan.title}</h3><div class="credential-fan-stack">{fan.credentials.map((credential, index) => <button type="button" class="credential-thumbnail" style={`--fan-index: ${index}; --fan-angle: ${index * 12}deg; --fan-x: ${index * 9}rem;`} data-credential-open data-credential-title={credential.title} data-credential-image={credential.image} data-credential-alt={credential.alt}><span class="credential-thumbnail-media"><img src={credential.image} alt="" loading="lazy" decoding="async" /></span><span class="credential-thumbnail-title">{credential.title}</span></button>)}</div></section>)}
            </div>
            <footer class="profile-footer">
              <div class="flex flex-col gap-5 text-sm text-slate-300 md:flex-row md:items-center md:justify-between">
                <div><p class="font-bold text-white">Jorge Troncoso</p><p class="mt-1 text-slate-400">Contáctame por:</p><div class="footer-contact-links"><a href="https://wa.me/56950254516" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp" title="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 2.8 9.2 5a1.9 1.9 0 0 1 .5 2.3l-1 2a14.5 14.5 0 0 0 6.1 6.1l2-1a1.9 1.9 0 0 1 2.3.5l2.2 2.6a1.9 1.9 0 0 1-.1 2.6l-1.5 1.5c-1.1 1.1-2.8 1.5-4.3 1C9.2 20.8 3.2 14.8 1.7 8.6c-.5-1.5-.1-3.2 1-4.3l1.5-1.5a1.9 1.9 0 0 1 2.4 0Z" /></svg></a><a href="mailto:jorge.troncoso4@gmail.com" aria-label="Enviar correo electrónico" title="Correo electrónico"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg></a></div></div>
                <div class="md:text-right"><p>Página web desarrollada en Astro</p><p class="mt-1 text-slate-400">Todos los derechos reservados.</p></div>
              </div>
            </footer>
          </section>
        </div>
      </div>
    </section>

    <dialog id="credential-dialog" class="credential-dialog" aria-labelledby="credential-dialog-title"><div class="credential-dialog-content"><button type="button" class="credential-dialog-close" aria-label="Cerrar certificado">Cerrar</button><button type="button" class="credential-dialog-image" aria-label="Cerrar vista ampliada del certificado"><img src="" alt="" /></button><p id="credential-dialog-title"></p></div></dialog>

    <section id="proyectos" data-view="proyectos" class="cube-panel" aria-labelledby="proyectos-title" aria-hidden="true">
      <div class="cube-panel-content container-shell py-28"><p class="eyebrow">Casos de trabajo</p><h1 id="proyectos-title" class="section-title" tabindex="-1">Proyectos destacados</h1><p class="section-copy">Una selección de aplicaciones web y trabajo aplicado con modelos de inteligencia artificial.</p><div class="mt-10 grid gap-5 md:grid-cols-3">{webProjects.map((project, index) => <article class="glass group flex min-h-[320px] flex-col rounded-3xl p-6 transition duration-300 hover:-translate-y-1 hover:border-cyan-300/25"><div class="mb-8 flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-[.16em] text-cyan-300">{project.category}</span><span class="text-4xl font-black text-white/10">0{index + 1}</span></div><h2 class="text-2xl font-black tracking-tight">{project.title}</h2><p class="mt-3 flex-1 text-sm leading-6 text-slate-300">{project.description}</p><div class="mt-5 flex flex-wrap gap-2">{project.technologies.slice(0, 5).map((tech) => <span class="tag">{tech}</span>)}</div><a href={`/proyectos/${project.slug}`} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-white">Ver caso de estudio <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span></a></article>)}</div>{modelProject && <article class="glass mt-5 grid gap-6 rounded-3xl p-7 md:grid-cols-[1.2fr_.8fr] md:p-9"><div><p class="eyebrow">{modelProject.category}</p><h2 class="mt-3 text-3xl font-black tracking-tight">{modelProject.title}</h2><p class="mt-4 max-w-2xl leading-7 text-slate-300">{modelProject.description}</p><a href={`/proyectos/${modelProject.slug}`} class="mt-7 inline-flex rounded-xl bg-white px-5 py-3 font-bold text-slate-950">Explorar el proyecto</a></div><div class="rounded-2xl border border-violet-300/20 bg-violet-300/[.04] p-6"><p class="text-xs font-bold uppercase tracking-[.16em] text-violet-200">Dominio legal chileno</p><p class="mt-4 text-lg font-bold">Gemma + LoRA/QLoRA</p><p class="mt-3 text-sm leading-6 text-slate-300">Datos legales, legislación y un agente de extracción de información jurídica desde fuentes web públicas.</p></div></article>}<div class="mt-8 text-center"><a href="/proyectos" class="inline-flex rounded-xl border border-white/15 bg-white/[.04] px-5 py-3 font-bold">Ver los cuatro proyectos</a></div></div>
    </section>

    <section id="inicio" data-view="inicio" class="cube-panel is-active" aria-labelledby="inicio-title" aria-hidden="false">
      <div class="cube-panel-content container-shell flex min-h-full items-center py-24"><div class="grid w-full items-center gap-12 lg:grid-cols-[1.12fr_.88fr]"><div class="reveal"><p class="eyebrow">Desarrollo web · IA local · RAG</p><h1 id="inicio-title" class="mt-5 max-w-4xl text-5xl font-black leading-[.98] tracking-[-.055em] sm:text-7xl" tabindex="-1">Construyo software que conecta <span class="bg-gradient-to-r from-cyan-300 via-blue-400 to-violet-400 bg-clip-text text-transparent">datos, procesos e inteligencia artificial.</span></h1><p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">Desarrollador enfocado en aplicaciones web, servicios backend e infraestructura local de IA para flujos documentales, recuperación de información y automatización.</p><div class="mt-9 flex flex-wrap gap-3"><a href="#proyectos" data-view-link="proyectos" class="rounded-xl bg-white px-5 py-3 font-bold text-slate-950">Ver proyectos</a><a href="mailto:jorge.troncoso4@gmail.com" class="rounded-xl border border-white/15 bg-white/[.04] px-5 py-3 font-bold text-white">Contactar</a></div><div class="mt-10 flex flex-wrap gap-2"><span class="tag">Laravel + React/Vue</span><span class="tag">FastAPI + Celery</span><span class="tag">Ollama + LangGraph</span><span class="tag">Docker + NVIDIA GPU</span></div></div><div class="glass relative min-h-[440px] overflow-hidden rounded-[2rem] p-6"><div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(103,232,249,.10),transparent_55%)]"></div><div class="relative flex h-full min-h-[390px] items-center justify-center"><div class="absolute h-72 w-72 rounded-full border border-cyan-300/15"></div><div class="absolute h-48 w-48 rounded-full border border-violet-300/15"></div><div class="z-10 rounded-3xl border border-cyan-300/30 bg-[#07101f] px-7 py-6 text-center shadow-[0_0_60px_rgba(34,211,238,.16)]"><p class="text-xs font-black tracking-[.22em] text-cyan-300">LOCAL AI CORE</p><p class="mt-2 text-2xl font-black">Desarrollo + IA</p><p class="mt-1 text-sm text-slate-300">Aplicaciones · APIs · modelos locales</p></div>{['Laravel UI', 'FastAPI', 'Workers', 'PostgreSQL', 'pgvector', 'RAG'].map((label, i) => <span class={`absolute rounded-full border border-white/10 bg-[#0b1020] px-3 py-2 text-xs text-slate-200 node-${i}`}>{label}</span>)}</div></div></div></div>
    </section>

    <section id="tecnologias" data-view="tecnologias" class="cube-panel" aria-labelledby="tecnologias-title" aria-hidden="true">
      <div class="cube-panel-content technology-view">
        <div class="technology-shell">
          <div class="technology-map-scroll" role="region" aria-label="Mapa completo de tecnologías organizado por especialidad.">
            <section class="technology-map" aria-labelledby="tecnologias-title">
              <img src="/images/technologies/technology-map.webp" alt="Mapa isométrico de una arquitectura tecnológica con zonas para frontend, backend, inteligencia artificial, infraestructura, datos, documentos y calidad." width="2392" height="1792" />
              <header class="technology-map-heading">
                <p>Stack técnico / arquitectura aplicada</p>
                <h1 id="tecnologias-title" tabindex="-1">Tecnologías</h1>
                <span>Herramientas conectadas para construir productos web, servicios, datos e inteligencia artificial local.</span>
              </header>
              <div class="technology-featured-heading"><span>Flujos integrados</span><h2>Stack destacado</h2></div>
              <div class="technology-featured-list">
                {featuredStack.map((stack, index) =>
                  <article class={`technology-featured technology-featured-${index + 1}`} tabindex="0">
                    <div>{stack.iconBody && <svg viewBox="0 0 24 24" aria-hidden="true" set:html={stack.iconBody} />}</div>
                    {index === 0 && <small>Interfaz Usuario</small>}
                    {index === 1 && <small>Intercomunicación asíncrona</small>}
                    {index === 2 && <small>Orquestación de Inteligencia Artificial</small>}
                    {index === 3 && <small>Infraestructura de Cómputo</small>}
                    <span>{stack.name}</span>
                  </article>
                )}
              </div>
              <div class="technology-map-items" role="list" aria-label="Tecnologías por especialidad">
                {technologyMapItems.map((tech) =>
                  <div class={`technology-map-item technology-map-item-${tech.category} technology-map-item-${tech.slug}`} style={`--map-x: ${tech.x}%; --map-y: ${tech.y}%`} role="listitem" tabindex="0" aria-label={`${tech.name}, ${categoryLabels[tech.category]}`}>
                    <span class="technology-map-icon">{tech.iconBody ? <svg viewBox="0 0 24 24" aria-hidden="true" set:html={tech.iconBody} /> : <b aria-hidden="true">{tech.name.slice(0, 2)}</b>}</span>
                    <span class="technology-map-name">{tech.name}</span>
                  </div>
