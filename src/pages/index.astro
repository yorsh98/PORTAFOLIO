---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { technologies, categoryLabels } from '../data/technologies';
import iconSet from '@iconify-json/simple-icons/icons.json';

const { hero, about, experience: X, featured, works, stack, localAi, credentials, services, contact } = site;

const customIcons: Record<string, string> = {
  llamacpp: '<path d="M7 3.5v5.2M10.2 3.5v5.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M5.6 8.7h6.2a2 2 0 0 1 2 2v1.8h3.4a2.3 2.3 0 0 1 2.3 2.3v5.7h-2.2v-3.6h-1.5v3.6h-2.2v-3.6H8.9v3.6H6.7v-3.6H5.2v3.6H3V12a3.3 3.3 0 0 1 2.6-3.3Z" fill="currentColor"/><circle cx="8.4" cy="11" r=".9" fill="#06070c"/>',
  argon2: '<rect x="4.5" y="10.5" width="15" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 14.2v2.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  cuda: '<rect x="4" y="4" width="16" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 9h8v6H8zM2 8h2m16 0h2M2 12h2m16 0h2M2 16h2m16 0h2M8 2v2m4-2v2m4-2v2M8 20v2m4-2v2m4-2v2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>'
};
const iconOf = (slug: string) => customIcons[slug] ?? iconSet.icons[slug as keyof typeof iconSet.icons]?.body;
const techGroups = (Object.keys(categoryLabels) as (keyof typeof categoryLabels)[]).map((cat) => ({
  label: categoryLabels[cat],
  items: technologies.filter((t) => t.category === cat).map((t) => ({ ...t, icon: iconOf(t.slug) }))
}));

const echoData = JSON.stringify({ word: site.preloader.word, featured: featured.items, works: works.items });
const CHEV = '<path d="m6 9 6 6 6-6"/>';
---
<BaseLayout home>
  <script type="application/json" id="echo-data" set:html={echoData} />

  <!-- 1 · PRELOADER -->
  <div id="preloader" aria-hidden="true">
    <svg class="pl-svg" viewBox="0 0 220 130" fill="none"><path id="plPath" d="M30 96 C 52 6, 150 -8, 160 62 C 166 104, 128 118, 116 92" /><circle id="plDot" r="3.4" /></svg>
    <div class="pl-word" id="plWord"></div>
  </div>

  <main id="contenido">
    <!-- 3 + 4 · HERO → SOBRE MÍ -->
    <section class="pin" id="home" data-nav-theme="dyn" aria-label="Inicio y presentación">
      <span class="anchor-about" id="about" aria-hidden="true"></span>
      <div class="stage">
        <div class="ha-bg"><canvas id="swirl"></canvas></div>
        <div class="ha-card" id="haCard">
          <div class="hero-layer" id="heroLayer">
            <h1 class="hero-title" aria-label={`${hero.line1} ${hero.line2}`}>
              <span class="ln l1" aria-hidden="true"><span>{hero.line1}</span></span>
              <span class="ln l2" aria-hidden="true"><span>{hero.line2}</span></span>
            </h1>
            <figure class="hero-portrait">
              {hero.portrait ? <img src={hero.portrait} alt="" /> : (
                <div class="core" data-core aria-label="Mapa del stack: pasa el mouse sobre cada componente">
                  <span class="core-orbit" aria-hidden="true"></span><span class="core-orbit o2" aria-hidden="true"></span>
                  <svg class="core-links" aria-hidden="true">{hero.core.nodes.map(() => <line />)}</svg>
                  <div class="core-box"><small>{hero.core.kicker}</small><b>{hero.core.title}</b></div>
                  <ul class="core-nodes">
                    {hero.core.nodes.map((n, i) => <li class="node" tabindex="0" style={`--d:${.9 + i * .1}s`}><span>{n.label}</span><em class="tip">{n.info}</em></li>)}
                  </ul>
                </div>
              )}
            </figure>
            <p class="hero-est mono">{hero.est}</p>
            <div class="hero-side"><p>{hero.tagline}</p><ul>{hero.side.map((t) => <li>{t}</li>)}</ul></div>
            <a class="hero-cue" href="#about" data-go="about" aria-label="Bajar a Sobre mí">↘</a>
          </div>
          <div class="about-layer" id="aboutLayer">
            <div class="beam"></div><div class="figure"></div>
            <div class="about-content" id="aboutContent">
              <div class="ab-top">
                <p class="ab-kicker">{about.kicker}</p>
                <ul class="ab-facts mono">{about.facts.map((f) => <li>{f}</li>)}</ul>
              </div>
              <div class="ab-mark" aria-hidden="true"><span>{site.brand.logo}</span></div>
              <div class="ab-bottom">
                <div class="ab-lead">
                  <h2 class="ab-head">{about.headline}</h2>
                  <p class="ab-intro">{about.intro}</p>
                  <div class="ab-cta">{about.ctas.map((c) => <a class:list={['btn', { primary: c.primary }]} href={`#${c.go}`} data-go={c.go}>{c.label}</a>)}</div>
                </div>
                <div class="ab-cols">{about.cols.map((c) => <div><b>{c.k}</b>{c.v}</div>)}</div>
              </div>
            </div>
          </div>
        </div>
        <div class="about-words" id="aboutWords" aria-hidden="true"><span id="wA">{about.words[0]}</span><span id="wB">{about.words[1]}</span></div>
      </div>
    </section>

    <!-- 5 · EXPERIENCIA -->
    <section class="pin exp" id="experience" data-nav-theme="dark" aria-label="Experiencia">
      <div class="stage">
        <div class="ghost" id="ghost" aria-hidden="true">{X.ghost.map((t) => <span>{t}&nbsp;&nbsp;{t}</span>)}</div>
        <div class="exp-track" id="expTrack">
          <div class="panel" data-tab="0"><div class="meta"><em>{X.kicker}</em></div><h2 class="ttl">{X.title[0]}<br />{X.title[1]}</h2><p class="desc">{X.intro}</p></div>
          {X.items.map((it) => (
            <article class="panel" data-tab={it.tab}>
              <div class="meta"><span>{it.dates}</span><span>{it.org}</span><em>{it.kind}</em></div>
              <h3 class="ttl">{it.title[0]}<br />{it.title[1]}</h3>
              <p class="desc">{it.text}</p>
              <div class="ms" style={`--milestone-columns: ${it.milestones.length}`}>{it.milestones.map((m) => <div><b>{m.k}</b>{m.v}</div>)}</div>
            </article>
          ))}
        </div>
        <div class="exp-tabs" id="expTabs">{X.tabs.map((t, i) => <button type="button" data-tab={i}>{t}</button>)}</div>
        <div class="exp-bar"><i id="expBar"></i></div>
        <div class="wipe" id="wipe"></div>
      </div>
    </section>

    <!-- 6 · PROYECTOS DESTACADOS -->
    <section class="pin feat" id="projects" data-nav-theme="light" aria-labelledby="feat-title">
      <div class="stage">
        <h2 class="eyebrow mono" id="feat-title">{featured.eyebrow}</h2>
        <canvas id="beltCanvas" aria-hidden="true"></canvas>
        <div class="cap" id="cap" aria-live="polite"><b id="capTitle"></b><span id="capSub"></span><small id="capIdx"></small><a id="capLink" class="cap-link" href="#" hidden>Ver caso de estudio ↗</a></div>
        <div class="cat">{featured.category}</div>
        <ul class="sr-only">{featured.items.map((it) => <li>{it.href ? <a href={it.href}>{it.title}: {it.sub}</a> : `${it.title}: ${it.sub}`}</li>)}</ul>
      </div>
    </section>

    <!-- 7 · OBRAS -->
    <section class="pin works" id="works" data-nav-theme="light" aria-label="Obras">
      <div class="stage" id="worksStage">
        <div class="ring">{works.items.map((it, i) => <div class="wcard" data-i={i} role="button" tabindex="0" aria-label={it.title}></div>)}</div>
        <div class="works-center" id="worksCenter">{works.center}</div>
        <a class="works-label" id="worksLabel"></a>
        <ul class="works-index" id="worksIndex">{works.items.map((it, i) => <li><button type="button" data-i={i}>{it.title}</button></li>)}</ul>
        <div class="works-hint mono">{works.hint}</div>
      </div>
    </section>

    <!-- STACK -->
    <section class="stack" id="stack" data-nav-theme="dark" aria-labelledby="stack-title">
      <div class="sec-line"></div>
      <p class="eyebrow-s mono" data-reveal>{stack.eyebrow}</p>
      <h2 class="big-title" id="stack-title" data-reveal>{stack.title}</h2>
      <p class="sec-text" data-reveal>{stack.text}</p>
      <div class="tech-groups">
        {techGroups.map((g, gi) => (
          <div class="tech-row" data-reveal style={`--delay:${gi * 80}ms`}>
            <h3 class="mono">{String(gi + 1).padStart(2, '0')} · {g.label}</h3>
            <ul>{g.items.map((t, ti) => <li style={`--i:${ti}`}>{t.icon ? <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} /> : <b aria-hidden="true">{t.name.slice(0, 2)}</b>}<span>{t.name}</span></li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <!-- IA LOCAL -->
    <section class="ai" id="ai" data-nav-theme="dark" aria-labelledby="ai-title">
      <p class="eyebrow-s mono" data-reveal>{localAi.eyebrow}</p>
      <h2 class="ai-title" id="ai-title" data-reveal><span>{localAi.title[0]}</span> <small>{localAi.title[1]}</small></h2>
      <p class="sec-text" data-reveal>{localAi.text}</p>
      <div class="models">
        <p class="eyebrow-s mono" data-reveal>{localAi.models.label}</p>
        <ul>{localAi.models.items.map((m) => <li data-reveal="seq"><b>{m.k}</b><span>{m.name}</span><p>{m.v}</p></li>)}</ul>
      </div>
      <ol class="layers">
        {localAi.layers.map((l, i) => (
          <li data-reveal="seq">
            <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
            <p class="mono lbl">{l.label}</p>
            <h3>{l.title}</h3>
            <p>{l.text}</p>
            <div class="tags">{l.tags.map((t) => <span>{t}</span>)}</div>
          </li>
        ))}
        <li class="hybrid" data-reveal="seq">
          <span class="n mono">07</span>
          <p class="mono lbl">{localAi.hybrid.label}</p>
          <h3>{localAi.hybrid.title}</h3>
          <div class="hybrid-flow" aria-hidden="true"><span>IA local</span><i></i><b>APIs</b><i></i><span>IA en la nube</span></div>
          <p>{localAi.hybrid.text}</p>
          <div class="tags">{localAi.hybrid.tags.map((t) => <span>{t}</span>)}</div>
        </li>
      </ol>
    </section>

    <!-- CREDENCIALES -->
    <section class="creds" id="credentials" data-nav-theme="light" aria-labelledby="cred-title">
      <p class="eyebrow-s mono" data-reveal>{credentials.eyebrow}</p>
      <h2 class="big-title" id="cred-title" data-reveal>{credentials.title}</h2>
      <p class="sec-text" data-reveal>{credentials.text}</p>
      <ol class="cred-acc" data-reveal="acc">
        {credentials.items.map((c, i) => (
          <li class:list={['cred-panel', { open: i === 0 }]} style={`--i:${i}`}>
            <button type="button" class="cred-tab" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`cred-${i}`}>
              <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{c.title}</span>
            </button>
            <div class="cred-body" id={`cred-${i}`} inert={i !== 0}>
              <button type="button" class="cred-img" data-cred={c.image} data-title={c.title} aria-label={`Ampliar certificado: ${c.title}`}>
                <img src={c.image} alt="" loading="lazy" decoding="async" width="640" height="420" />
              </button>
              <div class="cred-meta">
                <small class="mono">{c.kind} · {c.org}</small>
                <h3>{c.title}</h3>
                {c.verify && <a class="cred-verify mono" href={c.verify} target="_blank" rel="noopener noreferrer">Verificar credencial ↗</a>}
                <span class="cred-zoom mono">Clic en la imagen para ampliar</span>
              </div>
            </div>
          </li>
        ))}
      </ol>
      <dialog class="lightbox" id="credDialog" aria-label="Certificado ampliado">
        <button type="button" class="lb-close" data-close>Cerrar</button>
        <figure><img src="" alt="" /><figcaption></figcaption></figure>
      </dialog>
    </section>

    <!-- 8 · SERVICIOS -->
    <section class="services" id="services" data-nav-theme="light" aria-labelledby="sv-title">
      <h2 id="sv-title" data-reveal>{services.title}</h2>
      <p class="sv-text" data-reveal>{services.text}</p>
      <div class="acc">
        {services.items.map((s, i) => (
          <div class:list={['acc-item', { open: i === 0 }]}>
            <button type="button" class="acc-head" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`acc-${i}`}><span class="n">{i + 1}</span><span>{s.title}</span><svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" set:html={CHEV} /></button>
            <div class="acc-body" id={`acc-${i}`}><div><div class="in">{s.text}<div class="row"><span>{s.deliverables}</span><a href="#contact" data-go="contact">{s.cta} ↗</a></div></div></div></div>
          </div>
        ))}
      </div>
    </section>

    <!-- 9 · CONTACTO -->
    <section class="talk" id="contact" data-nav-theme="dark" aria-labelledby="talkTitle">
      <div class="talk-line"></div>
      <h2 class="chrome" id="talkTitle" aria-label={contact.title}>{[...contact.title].map((ch, i) => <span class="ch" style={`--i:${i}`} aria-hidden="true">{ch}</span>)}</h2>
      <nav class="tpills" aria-label="Canales de contacto">{contact.pills.map((p) => <a class:list={{ primary: p.primary }} href={p.href} target={p.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer">{p.label}</a>)}</nav>
      <footer class="foot mono">{contact.footer.map((t) => <span>{t}</span>)}</footer>
    </section>
  </main>

  <script>
    import '../scripts/echo';
    document.querySelectorAll<HTMLElement>('.acc-item').forEach((it, _, all) => it.querySelector('.acc-head')!.addEventListener('click', () => {
      const open = !it.classList.contains('open');
      all.forEach((o) => { o.classList.remove('open'); o.querySelector('.acc-head')!.setAttribute('aria-expanded', 'false'); });
      if (open) { it.classList.add('open'); it.querySelector('.acc-head')!.setAttribute('aria-expanded', 'true'); }
    }));
  </script>
</BaseLayout>
