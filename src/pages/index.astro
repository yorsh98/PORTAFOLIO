---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { technologies, categoryLabels } from '../data/technologies';
import iconSet from '@iconify-json/simple-icons/icons.json';

const selectedTech = technologies.map((tech) => ({ ...tech, iconBody: iconSet.icons[tech.slug as keyof typeof iconSet.icons]?.body }));
const categoryColors: Record<string, string> = { frontend: '#67e8f9', backend: '#60a5fa', ai: '#a78bfa', data: '#2dd4bf', infrastructure: '#34d399', documents: '#fbbf24', audio: '#fb7185', quality: '#c4b5fd' };
const technologyGroups = Object.entries(categoryLabels).map(([category, label]) => ({ label, color: categoryColors[category], technologies: selectedTech.filter((tech) => tech.category === category) }));
const webProjects = projects.filter((project) => project.kind === 'web');
const modelProject = projects.find((project) => project.kind === 'model');
---
<BaseLayout hideFooter={true} panelNavigation={true}>
  <main id="contenido" class="cube-stage">
    <section id="perfil" data-view="perfil" class="cube-panel" aria-labelledby="perfil-title" aria-hidden="true">
      <div class="cube-panel-content container-shell py-28"><div class="grid min-h-full content-center gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow">Perfil</p><h1 id="perfil-title" class="section-title" tabindex="-1">Software con contexto técnico</h1></div><div><p class="section-copy text-lg">Trabajo en aplicaciones web y backend, conectando interfaces, APIs, procesamiento asíncrono y datos con herramientas de inteligencia artificial ejecutadas de forma local cuando el contexto lo requiere.</p><div class="mt-7 grid gap-3 sm:grid-cols-2"><div class="glass rounded-2xl p-5"><strong>Arquitectura práctica</strong><p class="mt-2 text-sm leading-6 text-slate-300">APIs, workers, bases de datos y pipelines pensados para integrarse con procesos reales.</p></div><div class="glass rounded-2xl p-5"><strong>IA con control de datos</strong><p class="mt-2 text-sm leading-6 text-slate-300">Modelos locales, embeddings y recuperación de información para tratar contenido sensible con mayor control.</p></div></div></div></div></div>
    </section>

    <section id="proyectos" data-view="proyectos" class="cube-panel" aria-labelledby="proyectos-title" aria-hidden="true">
      <div class="cube-panel-content container-shell py-28"><p class="eyebrow">Casos de trabajo</p><h1 id="proyectos-title" class="section-title" tabindex="-1">Proyectos destacados</h1><p class="section-copy">Una selección de aplicaciones web y trabajo aplicado con modelos de inteligencia artificial.</p><div class="mt-10 grid gap-5 md:grid-cols-3">{webProjects.map((project, index) => <article class="glass group flex min-h-[320px] flex-col rounded-3xl p-6 transition duration-300 hover:-translate-y-1 hover:border-cyan-300/25"><div class="mb-8 flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-[.16em] text-cyan-300">{project.category}</span><span class="text-4xl font-black text-white/10">0{index + 1}</span></div><h2 class="text-2xl font-black tracking-tight">{project.title}</h2><p class="mt-3 flex-1 text-sm leading-6 text-slate-300">{project.description}</p><div class="mt-5 flex flex-wrap gap-2">{project.technologies.slice(0, 5).map((tech) => <span class="tag">{tech}</span>)}</div><a href={`/proyectos/${project.slug}`} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-white">Ver caso de estudio <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span></a></article>)}</div>{modelProject && <article class="glass mt-5 grid gap-6 rounded-3xl p-7 md:grid-cols-[1.2fr_.8fr] md:p-9"><div><p class="eyebrow">{modelProject.category}</p><h2 class="mt-3 text-3xl font-black tracking-tight">{modelProject.title}</h2><p class="mt-4 max-w-2xl leading-7 text-slate-300">{modelProject.description}</p><a href={`/proyectos/${modelProject.slug}`} class="mt-7 inline-flex rounded-xl bg-white px-5 py-3 font-bold text-slate-950">Explorar el proyecto</a></div><div class="rounded-2xl border border-violet-300/20 bg-violet-300/[.04] p-6"><p class="text-xs font-bold uppercase tracking-[.16em] text-violet-200">Dominio legal chileno</p><p class="mt-4 text-lg font-bold">Gemma + LoRA/QLoRA</p><p class="mt-3 text-sm leading-6 text-slate-300">Datos legales, legislación y un agente de extracción de información jurídica desde fuentes web públicas.</p></div></article>}<div class="mt-8 text-center"><a href="/proyectos" class="inline-flex rounded-xl border border-white/15 bg-white/[.04] px-5 py-3 font-bold">Ver los cuatro proyectos</a></div></div>
    </section>

    <section id="inicio" data-view="inicio" class="cube-panel is-active" aria-labelledby="inicio-title" aria-hidden="false">
      <div class="cube-panel-content container-shell flex min-h-full items-center py-24"><div class="grid w-full items-center gap-12 lg:grid-cols-[1.12fr_.88fr]"><div class="reveal"><p class="eyebrow">Desarrollo web · IA local · RAG</p><h1 id="inicio-title" class="mt-5 max-w-4xl text-5xl font-black leading-[.98] tracking-[-.055em] sm:text-7xl" tabindex="-1">Construyo software que conecta <span class="bg-gradient-to-r from-cyan-300 via-blue-400 to-violet-400 bg-clip-text text-transparent">datos, procesos e inteligencia artificial.</span></h1><p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">Desarrollador enfocado en aplicaciones web, servicios backend e infraestructura local de IA para flujos documentales, recuperación de información y automatización.</p><div class="mt-9 flex flex-wrap gap-3"><a href="#proyectos" data-view-link="proyectos" class="rounded-xl bg-white px-5 py-3 font-bold text-slate-950">Ver proyectos</a><a href="mailto:jorge.troncoso4@gmail.com" class="rounded-xl border border-white/15 bg-white/[.04] px-5 py-3 font-bold text-white">Contactar</a></div><div class="mt-10 flex flex-wrap gap-2"><span class="tag">Laravel + React/Vue</span><span class="tag">FastAPI + Celery</span><span class="tag">Ollama + LangGraph</span><span class="tag">Docker + NVIDIA GPU</span></div></div><div class="glass relative min-h-[440px] overflow-hidden rounded-[2rem] p-6"><div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(103,232,249,.10),transparent_55%)]"></div><div class="relative flex h-full min-h-[390px] items-center justify-center"><div class="absolute h-72 w-72 rounded-full border border-cyan-300/15"></div><div class="absolute h-48 w-48 rounded-full border border-violet-300/15"></div><div class="z-10 rounded-3xl border border-cyan-300/30 bg-[#07101f] px-7 py-6 text-center shadow-[0_0_60px_rgba(34,211,238,.16)]"><p class="text-xs font-black tracking-[.22em] text-cyan-300">LOCAL AI CORE</p><p class="mt-2 text-2xl font-black">Desarrollo + IA</p><p class="mt-1 text-sm text-slate-300">Aplicaciones · APIs · modelos locales</p></div>{['Laravel UI', 'FastAPI', 'Workers', 'PostgreSQL', 'pgvector', 'RAG'].map((label, i) => <span class={`absolute rounded-full border border-white/10 bg-[#0b1020] px-3 py-2 text-xs text-slate-200 node-${i}`}>{label}</span>)}</div></div></div></div>
    </section>

    <section id="tecnologias" data-view="tecnologias" class="cube-panel" aria-labelledby="tecnologias-title" aria-hidden="true">
      <div class="cube-panel-content container-shell py-28"><p class="eyebrow">Stack técnico</p><h1 id="tecnologias-title" class="section-title" tabindex="-1">Tecnologías organizadas por especialidad</h1><p class="section-copy">Herramientas utilizadas en aplicaciones web, backend, procesamiento y flujos de inteligencia artificial.</p><div class="mt-10 grid gap-8">{technologyGroups.map((group) => <section><h2 class="mb-4 text-sm font-black uppercase tracking-[.16em]" style={`color: ${group.color}`}>{group.label}</h2><div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">{group.technologies.map((tech) => <article class="tech-card" style={`--tech-color: ${group.color}`}><div class="tech-icon">{tech.iconBody ? <svg viewBox="0 0 24 24" aria-hidden="true" set:html={tech.iconBody} /> : <span aria-hidden="true">{tech.name.slice(0, 2)}</span>}</div><h3>{tech.name}</h3></article>)}</div></section>)}</div></div>
    </section>

    <section id="ia-local" data-view="ia-local" class="cube-panel" aria-labelledby="ia-local-title" aria-hidden="true">
      <div class="cube-panel-content container-shell py-28"><div class="grid min-h-full content-center gap-8 lg:grid-cols-[.92fr_1.08fr]"><div><p class="eyebrow">Entorno de cómputo</p><h1 id="ia-local-title" class="section-title" tabindex="-1">Infraestructura local de IA</h1><p class="section-copy">Un entorno local para ejecutar portales, APIs, workers, bases de datos, OCR, transcripción, recuperación de información y fine-tuning con aceleración GPU.</p><div class="mt-7 flex flex-wrap gap-2"><span class="tag">Ubuntu</span><span class="tag">NVIDIA GPU</span><span class="tag">CUDA</span><span class="tag">Docker Compose</span><span class="tag">NVIDIA Toolkit</span></div></div><div class="glass rounded-3xl p-6"><div class="grid gap-3 sm:grid-cols-2"><div class="rounded-2xl border border-white/10 bg-black/20 p-5"><p class="text-xs font-bold uppercase tracking-widest text-cyan-300">Modelos</p><p class="mt-3 text-lg font-bold">Gemma · Qwen · embeddings</p><p class="mt-2 text-sm leading-6 text-slate-300">Modelos locales y adaptadores LoRA/QLoRA para experimentar con tareas especializadas.</p></div><div class="rounded-2xl border border-white/10 bg-black/20 p-5"><p class="text-xs font-bold uppercase tracking-widest text-violet-300">Datos</p><p class="mt-3 text-lg font-bold">PostgreSQL · pgvector</p><p class="mt-2 text-sm leading-6 text-slate-300">Persistencia relacional y recuperación vectorial para aplicaciones con contexto documental.</p></div><div class="rounded-2xl border border-white/10 bg-black/20 p-5"><p class="text-xs font-bold uppercase tracking-widest text-blue-300">Procesamiento</p><p class="mt-3 text-lg font-bold">OCR · audio · NLP</p><p class="mt-2 text-sm leading-6 text-slate-300">Herramientas para extraer, transformar y consultar contenido de distintas fuentes.</p></div><div class="rounded-2xl border border-white/10 bg-black/20 p-5"><p class="text-xs font-bold uppercase tracking-widest text-emerald-300">Orquestación</p><p class="mt-3 text-lg font-bold">APIs · workers · health checks</p><p class="mt-2 text-sm leading-6 text-slate-300">Servicios desacoplados para tareas de aplicación y procesamiento asíncrono.</p></div></div></div></div></div>
    </section>
  </main>

  <style>
    .node-0{top:12%;left:8%}.node-1{top:18%;right:7%}.node-2{bottom:18%;left:5%}.node-3{bottom:9%;right:10%}.node-4{top:47%;left:2%}.node-5{top:47%;right:2%}
    @media(max-width:640px){.node-4,.node-5{display:none}}
  </style>
  <script>
    const views = ['perfil', 'proyectos', 'inicio', 'tecnologias', 'ia-local'];
    const isView = (view: string): view is typeof views[number] => views.includes(view);

    let showView: ((next: string, focus?: boolean) => void) | undefined;
    const initializeViews = () => {
      if (location.pathname !== '/') {
        showView = undefined;
        return;
      }

      const panels = new Map(views.map((view) => [view, document.querySelector<HTMLElement>(`[data-view="${view}"]`)]));
      if (views.some((view) => !panels.get(view))) return;

      let active = 'inicio';
      let isTransitioning = false;
      const updateLinks = (view: string) => document.querySelectorAll<HTMLAnchorElement>('[data-view-link]').forEach((link) => {
        if (link.dataset.viewLink === view) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
      showView = (next, focus = true) => {
        if (!isView(next) || next === active || isTransitioning) return;
        const outgoing = panels.get(active);
        const incoming = panels.get(next);
        if (!outgoing || !incoming) return;
        isTransitioning = true;
        const direction = views.indexOf(next) > views.indexOf(active) ? 'forward' : 'backward';
        outgoing.classList.add(`cube-leave-${direction}`);
        incoming.classList.add(`cube-enter-${direction}`);
        incoming.setAttribute('aria-hidden', 'false');
        window.setTimeout(() => {
          outgoing.classList.remove('is-active', `cube-leave-${direction}`);
          outgoing.setAttribute('aria-hidden', 'true');
          incoming.classList.remove(`cube-enter-${direction}`);
          incoming.classList.add('is-active');
          active = next;
          updateLinks(active);
          isTransitioning = false;
          if (focus) incoming.querySelector<HTMLElement>('h1')?.focus({ preventScroll: true });
        }, 620);
      };

      const initial = location.hash.slice(1);
      if (isView(initial) && initial !== active) {
        panels.get(active)?.classList.remove('is-active');
        panels.get(active)?.setAttribute('aria-hidden', 'true');
        panels.get(initial)?.classList.add('is-active');
        panels.get(initial)?.setAttribute('aria-hidden', 'false');
        active = initial;
      }
      updateLinks(active);
    };

    initializeViews();
    document.addEventListener('astro:page-load', initializeViews);
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('[data-view-link]');
      const next = link?.dataset.viewLink;
      if (!next || !isView(next) || location.pathname !== '/') return;
      event.preventDefault();
      if (location.hash !== `#${next}`) {
        history.pushState(null, '', `#${next}`);
      }
      showView?.(next);
    });
    window.addEventListener('popstate', () => showView?.(location.hash.slice(1)));
    window.addEventListener('hashchange', () => showView?.(location.hash.slice(1)));
  </script>
</BaseLayout>
