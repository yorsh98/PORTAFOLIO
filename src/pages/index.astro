  <template id="project-panel-footer-template"><footer class="project-panel-footer"><div class="flex flex-col gap-5 text-sm text-slate-300 md:flex-row md:items-center md:justify-between"><div><p class="font-bold text-white">Jorge Troncoso</p><p class="mt-1 text-slate-400">Contáctame por:</p><div class="footer-contact-links"><a href="https://wa.me/56950254516" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp" title="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 2.8 9.2 5a1.9 1.9 0 0 1 .5 2.3l-1 2a14.5 14.5 0 0 0 6.1 6.1l2-1a1.9 1.9 0 0 1 2.3.5l2.2 2.6a1.9 1.9 0 0 1-.1 2.6l-1.5 1.5c-1.1 1.1-2.8 1.5-4.3 1C9.2 20.8 3.2 14.8 1.7 8.6c-.5-1.5-.1-3.2 1-4.3l1.5-1.5a1.9 1.9 0 0 1 2.4 0Z" /></svg></a><a href="mailto:jorge.troncoso4@gmail.com" aria-label="Enviar correo electrónico" title="Correo electrónico"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg></a></div></div><div class="md:text-right"><p>Página web desarrollada en Astro</p><p class="mt-1 text-slate-400">Todos los derechos reservados.</p></div></div></footer></template>

  <script>
    const initializeCredentialGallery = () => {
      const dialog = document.querySelector<HTMLDialogElement>('#credential-dialog');
      if (!dialog || dialog.dataset.bound === 'true') return;
      const image = dialog.querySelector<HTMLImageElement>('img');
      const title = dialog.querySelector<HTMLElement>('#credential-dialog-title');
      const close = dialog.querySelector<HTMLButtonElement>('.credential-dialog-close');
      const imageButton = dialog.querySelector<HTMLButtonElement>('.credential-dialog-image');
      if (!image || !title || !close || !imageButton) return;
      dialog.dataset.bound = 'true';
      let opener: HTMLButtonElement | null = null;
      document.querySelectorAll<HTMLButtonElement>('[data-credential-open]').forEach((button) => button.addEventListener('click', () => {
        opener = button;
        image.src = button.dataset.credentialImage ?? '';
        image.alt = button.dataset.credentialAlt ?? '';
        title.textContent = button.dataset.credentialTitle ?? '';
        dialog.showModal();
      }));
      const closeDialog = () => dialog.close();
      close.addEventListener('click', closeDialog);
      imageButton.addEventListener('click', closeDialog);
      dialog.addEventListener('click', (event) => { if (event.target === dialog) closeDialog(); });
      dialog.addEventListener('close', () => { opener?.focus(); opener = null; });
    };

    initializeCredentialGallery();
    document.addEventListener('astro:page-load', initializeCredentialGallery);

    const initializeCredentialFans = () => {
      const fans = document.querySelectorAll<HTMLElement>('[data-credential-fan]');
      if (!fans.length || !('IntersectionObserver' in window)) {
        fans.forEach((fan) => fan.classList.add('is-active'));
        return;
      }
      const observer = new IntersectionObserver((entries, activeObserver) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        (entry.target as HTMLElement).classList.add('is-active');
        activeObserver.unobserve(entry.target);
      }), { threshold: .3 });
      fans.forEach((fan) => {
        if (fan.dataset.fanObserved === 'true') return;
        fan.dataset.fanObserved = 'true';
        observer.observe(fan);
      });
    };

    initializeCredentialFans();
    document.addEventListener('astro:page-load', initializeCredentialFans);

    const initializeProfileTechStrips = () => {
      document.querySelectorAll<HTMLElement>('[data-profile-tech-strip]').forEach((strip) => {
        if (strip.dataset.bound === 'true') return;
        strip.dataset.bound = 'true';
        let startX = 0;
        let startScrollLeft = 0;
        let dragging = false;
        let paused = false;
        let animationFrame = 0;
        let lastFrame = 0;
        let currentScrollLeft = strip.scrollLeft;
        let loopAt = 0;
        const animate = (timestamp: number) => {
          if (!lastFrame) lastFrame = timestamp;
          const elapsed = timestamp - lastFrame;
          lastFrame = timestamp;
          if (!loopAt) loopAt = strip.scrollWidth / 2;
          if (!paused && loopAt && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            currentScrollLeft += elapsed * .06;
            if (currentScrollLeft >= loopAt) currentScrollLeft -= loopAt;
            strip.scrollLeft = currentScrollLeft;
          }
          animationFrame = window.requestAnimationFrame(animate);
        };
        animationFrame = window.requestAnimationFrame(animate);
        strip.addEventListener('pointerdown', (event) => {
          dragging = true;
          paused = true;
          startX = event.clientX;
          startScrollLeft = strip.scrollLeft;
          currentScrollLeft = startScrollLeft;
          strip.setPointerCapture(event.pointerId);
          strip.classList.add('is-dragging');
        });
        strip.addEventListener('pointermove', (event) => {
          if (!dragging) return;
          strip.scrollLeft = startScrollLeft - (event.clientX - startX);
          currentScrollLeft = strip.scrollLeft;
        });
        const stopDragging = (event: PointerEvent) => {
          if (!dragging) return;
          dragging = false;
          strip.releasePointerCapture(event.pointerId);
          strip.classList.remove('is-dragging');
          paused = false;
        };
        strip.addEventListener('pointerup', stopDragging);
        strip.addEventListener('pointercancel', stopDragging);
        strip.addEventListener('mouseenter', () => { paused = true; });
        strip.addEventListener('mouseleave', () => { if (!dragging) paused = false; });
        strip.addEventListener('focusin', () => { paused = true; });
        strip.addEventListener('focusout', () => { paused = false; });
        strip.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          currentScrollLeft = Math.max(0, currentScrollLeft + (event.key === 'ArrowRight' ? 180 : -180));
          strip.scrollLeft = currentScrollLeft;
        });
        document.addEventListener('astro:before-swap', () => window.cancelAnimationFrame(animationFrame), { once: true });
      });
    };

    initializeProfileTechStrips();
    document.addEventListener('astro:page-load', initializeProfileTechStrips);

    const makeProjectCardsClickable = () => {
      const projectsPanel = document.querySelector<HTMLElement>('#proyectos');
      if (!projectsPanel) return;
      const links = Array.from(projectsPanel.querySelectorAll<HTMLAnchorElement>('a[href^="/proyectos/"]'));
      links.forEach((link) => {
        const card = link.closest<HTMLElement>('article');
        if (!card || card.dataset.cardLinkBound === 'true') return;
        card.dataset.cardLinkBound = 'true';
        card.tabIndex = 0;
        card.style.cursor = 'pointer';
        card.setAttribute('role', 'link');
        card.setAttribute('aria-label', `Ver proyecto: ${card.querySelector('h2')?.textContent?.trim() ?? ''}`);
        link.tabIndex = -1;
        const navigate = () => window.location.assign(link.href);
        card.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a, button')) return;
          navigate();
        });
        card.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          navigate();
        });
      });
    };

    makeProjectCardsClickable();
    document.addEventListener('astro:page-load', makeProjectCardsClickable);

    const arrangeProjectCards = () => {
      const projectsPanel = document.querySelector<HTMLElement>('#proyectos');
      const grid = projectsPanel?.querySelector<HTMLElement>('.mt-10.grid');
      const modelCard = projectsPanel?.querySelector<HTMLAnchorElement>('a[href="/proyectos/legal-chile-gemma"]')?.closest<HTMLElement>('article');
      if (!projectsPanel || !grid || !modelCard) return;
      let anchor = projectsPanel.querySelector<HTMLElement>('[data-project-model-anchor]');
      if (!anchor) {
        anchor = document.createElement('span');
        anchor.hidden = true;
        anchor.dataset.projectModelAnchor = 'true';
        modelCard.before(anchor);
      }
      const compactLayout = window.matchMedia('(min-width: 768px) and (max-width: 1279px)').matches;
      if (compactLayout) {
        modelCard.classList.add('project-model-card');
        grid.append(modelCard);
      } else {
        modelCard.classList.remove('project-model-card');
        anchor.after(modelCard);
      }
    };

    arrangeProjectCards();
    window.addEventListener('resize', arrangeProjectCards);
    document.addEventListener('astro:page-load', arrangeProjectCards);

    const initializeProjectPanelFooter = () => {
      const panelContent = document.querySelector<HTMLElement>('#proyectos .cube-panel-content');
      const template = document.querySelector<HTMLTemplateElement>('#project-panel-footer-template');
      if (!panelContent || !template || panelContent.querySelector('.project-panel-footer')) return;
      panelContent.append(template.content.cloneNode(true));
    };

    initializeProjectPanelFooter();
    document.addEventListener('astro:page-load', initializeProjectPanelFooter);

    const initializeHomePanelFooter = () => {
      const panelContent = document.querySelector<HTMLElement>('#inicio .cube-panel-content');
      const template = document.querySelector<HTMLTemplateElement>('#project-panel-footer-template');
      if (!panelContent || !template || panelContent.querySelector('.home-panel-footer')) return;
      const footer = template.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
      if (!footer) return;
      footer.classList.replace('project-panel-footer', 'home-panel-footer');
      const contactLabel = footer.querySelector<HTMLElement>('p.font-bold');
      if (contactLabel) contactLabel.textContent = 'Jorge Troncoso';
      panelContent.append(footer);
    };

    initializeHomePanelFooter();
    document.addEventListener('astro:page-load', initializeHomePanelFooter);

    const layoutTechnologyMap = (resetPosition = false) => {
      const viewport = document.querySelector<HTMLElement>('.technology-map-scroll');
      const map = viewport?.querySelector<HTMLElement>('.technology-map');
      if (!viewport || !map) return;
      if (!window.matchMedia('(max-width: 767px)').matches) {
        map.style.removeProperty('width');
        map.style.removeProperty('height');
        return;
      }
      const height = viewport.clientHeight;
      if (!height) return;
      map.style.width = `${height * (2392 / 1792)}px`;
      map.style.height = `${height}px`;
      if (resetPosition) {
        viewport.scrollLeft = 0;
        viewport.scrollTop = 0;
      }
    };

    const initializeTechnologyMapLayout = () => {
      const viewport = document.querySelector<HTMLElement>('.technology-map-scroll');
      if (!viewport) return;
      layoutTechnologyMap(true);
      if (viewport.dataset.layoutObserved === 'true') return;
      viewport.dataset.layoutObserved = 'true';
      new ResizeObserver(() => layoutTechnologyMap()).observe(viewport);
    };

    initializeTechnologyMapLayout();
    document.addEventListener('astro:page-load', initializeTechnologyMapLayout);

    const views = ['perfil', 'proyectos', 'inicio', 'tecnologias', 'ia-local'] as const;
    type View = typeof views[number];
    const isView = (view: string): view is View => (views as readonly string[]).includes(view);

    let showView: ((next: string) => void) | undefined;
    const initializeViews = () => {
      if (location.pathname !== '/') {
        showView = undefined;
        return;
      }

      const panels = new Map(views.map((view) => [view, document.querySelector<HTMLElement>(`[data-view="${view}"]`)]));
      if (views.some((view) => !panels.get(view))) return;

      const resetPanelScroll = (panel: HTMLElement) => {
        const content = panel.querySelector<HTMLElement>('.cube-panel-content');
        if (content) content.scrollTop = 0;
      };
      const updateLinks = (view: string) => document.querySelectorAll<HTMLAnchorElement>('[data-view-link]').forEach((link) => {
        if (link.dataset.viewLink === view) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
      const activateView = (next: View) => {
        panels.forEach((panel, view) => {
          if (!panel) return;
          panel.classList.remove('is-active', 'cube-enter-left', 'cube-enter-right', 'cube-enter-top', 'cube-enter-bottom', 'cube-enter-front', 'cube-leave-left', 'cube-leave-right', 'cube-leave-top', 'cube-leave-bottom', 'cube-leave-front');
          const isActive = view === next;
          panel.setAttribute('aria-hidden', String(!isActive));
          if (isActive) {
            resetPanelScroll(panel);
            panel.classList.add('is-active');
          }
        });
        updateLinks(next);
        if (next === 'tecnologias') layoutTechnologyMap(true);
      };
      showView = (next) => {
        if (!isView(next)) return;
        activateView(next);
      };

      const initial = location.hash.slice(1);
      activateView(isView(initial) ? initial : 'inicio');
    };

    initializeViews();
    if (document.documentElement.dataset.viewNavigationBound !== 'true') {
      document.documentElement.dataset.viewNavigationBound = 'true';
      document.addEventListener('astro:page-load', initializeViews);
      document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('[data-view-link]');
      const next = link?.dataset.viewLink;
      if (!next || !isView(next) || location.pathname !== '/') return;
      event.preventDefault();
      if (location.hash !== `#${next}`) {
        history.pushState(null, '', `#${next}`);
      }
      showView?.(next);
      });
      window.addEventListener('popstate', () => showView?.(location.hash.slice(1)));
      window.addEventListener('hashchange', () => showView?.(location.hash.slice(1)));
    }
  </script>
</BaseLayout>
